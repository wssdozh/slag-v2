<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds keep the manifest's usesCleartextTraffic="true" behaviour: a relay on the LAN
     (http://192.168.x.x:8320) has to work while the address is still being picked. A network
     security config wins over that attribute on API 24+, so the permissive case has to be
     spelled out here. Release uses the scoped allowlist in src/main/res/xml. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
