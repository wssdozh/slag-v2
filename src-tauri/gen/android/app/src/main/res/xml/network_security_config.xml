<?xml version="1.0" encoding="utf-8"?>
<!-- The relay speaks plain HTTP and ws:// (see DEFAULT_SYNC_SERVER_URL), and Android's WebView
     refuses cleartext for the whole app unless the host is named here. Release builds set
     usesCleartextTraffic="false", so every fetch and every socket to the relay died with
     "Failed to fetch" on the phone while the desktop build reached the same server.
     Only the relay hosts and a loopback tunnel may go plain; everything else stays HTTPS-only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- The official relay runs without TLS for now: http://152.53.199.71:8320. -->
        <domain includeSubdomains="false">152.53.199.71</domain>
        <domain includeSubdomains="true">slag.app</domain>
        <!-- A relay behind a local tunnel or the emulator loopback. -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
