{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for SLAG v2 desktop and mobile windows",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:webview:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-unminimize",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-set-focus",
    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:scope-appdata-recursive",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:default",
    "opener:default",
    "android-fs:allow-get-name",
    "android-fs:allow-get-metadata",
    "android-fs:allow-get-file-thumbnail-as-data-url",
    "android-fs:allow-read-dir",
    "android-fs:allow-read-file",
    "android-fs:allow-read-file-as-data-url",
    "android-fs:allow-show-open-dir-picker",
    "android-fs:allow-show-open-file-picker",
    "android-fs:allow-show-save-file-picker",
    "android-fs:allow-write-file",
    "android-fs:allow-persist-picker-uri-permission",
    "android-fs:allow-check-persisted-picker-uri-permission",
    "android-fs:allow-list-all-persisted-picker-uri-permissions"
  ]
}
