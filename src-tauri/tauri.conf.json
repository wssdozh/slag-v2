{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "SLAG",
  "version": "0.1.0",
  "identifier": "com.slag.notes",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SLAG",
        "width": 1240,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "transparent": false,
        "theme": "Dark",
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,msEdgeAutofill,msEdgeShopping,msEdgeWallet,Translate,MediaRouter,msEdgeHub,msEdgeSidebarV2,msEdgeVisualSearch,msEdgeCollections,msEdgeDiagnosticData --disable-background-networking --disable-component-update --disable-sync --disable-extensions --disable-speech-api --disable-print-preview --js-flags=\"--scavenger_max_new_space_capacity_mb=4 --optimize_for_size --max_old_space_size=512\""
      },
      {
        "label": "quick-composer",
        "title": "SLAG — Быстрая мысль",
        "url": "index.html?window=quick-composer",
        "width": 660,
        "height": 220,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,msEdgeAutofill,msEdgeShopping,msEdgeWallet,Translate,MediaRouter,msEdgeHub,msEdgeSidebarV2,msEdgeVisualSearch,msEdgeCollections,msEdgeDiagnosticData --disable-background-networking --disable-component-update --disable-sync --disable-extensions --disable-speech-api --disable-print-preview --js-flags=\"--scavenger_max_new_space_capacity_mb=4 --optimize_for_size --max_old_space_size=512\""
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
