{
  "name": "slag-v2",
  "private": true,
  "version": "0.2.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "tauri dev",
    "build": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && vite build && vite build --config vite.mcp.config.ts && vite build --config vite.node.config.ts",
    "build:mcp": "vite build --config vite.mcp.config.ts",
    "build:node": "vite build --config vite.node.config.ts",
    "mcp": "node dist/mcp/index.js",
    "node": "node dist/node/index.js",
    "build:desktop": "tauri build",
    "build:desktop:fast": "cargo build --profile fast --manifest-path src-tauri/Cargo.toml",
    "build:android": "tauri android build --debug --apk --target aarch64",
    "build:android:release": "tauri android build --apk --target aarch64",
    "android:install": "adb install -r src-tauri/gen/android/app/build/outputs/apk/universal/debug/app-universal-debug.apk",
    "android:install:release": "adb install -r src-tauri/gen/android/app/build/outputs/apk/universal/release/app-universal-release.apk",
    "android:run": "adb shell am start -n com.slag.notes/com.slag.notes.MainActivity",
    "android:log": "adb logcat -s RustStdoutStderr:V SLAG:* chromium:I",
    "lint": "oxlint",
    "check": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && oxlint",
    "map:code": "node scripts/gen-code-map.mjs",
    "where": "node scripts/gen-code-map.mjs where",
    "test:e2e": "playwright test",
    "shots": "playwright test e2e/quick_shots.spec.ts",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@atomic-editor/editor": "^0.6.2",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.5.4",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@noble/curves": "^2.4.0",
    "@orama/orama": "^3.1.18",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-fs": "^2.7.0",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "chrono-node": "^2.10.3",
    "dockview-react": "^8.6.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tauri-plugin-android-fs-api": "30.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
